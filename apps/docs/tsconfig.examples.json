{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "bun"
    ],
    "skipLibCheck": true,
    "paths": {
      "@hwpjs/core": [
        "../../packages/core/src/index.ts"
      ],
      "@hwpjs/core/runtime": [
        "../../packages/core/src/runtime.ts"
      ],
      "@hwpjs/vanilla": [
        "../../packages/vanilla/src/index.ts"
      ],
      "@hwpjs/react": [
        "../../packages/react/src/index.ts"
      ],
      "@hwpjs/svelte": [
        "../../packages/svelte/src/index.ts"
      ]
    }
  },
  "include": [
    "examples/**/*.ts",
    "examples/**/*.tsx",
    "types/**/*.d.ts",
    "rspress.config.ts",
    "components/**/*.tsx",
    "theme/**/*.tsx"
  ]
}
