{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "bun"
    ],
    "skipLibCheck": true,
    "paths": {
      "@hwpjs/core": [
        "../../packages/core/src/index.ts"
      ],
      "@hwpjs/core/runtime": [
        "../../packages/core/src/runtime.ts"
      ],
      "@hwpjs/vanilla": [
        "../../packages/vanilla/src/index.ts"
      ],
      "@hwpjs/react": [
        "../../packages/react/src/index.ts"
      ],
      "@hwpjs/svelte": [
        "../../packages/svelte/src/index.ts"
      ],
      "@ohah/hwpjs": [
        "../../packages/hwpjs/src/index.ts"
      ],
      "@ohah/hwpjs/runtime": [
        "../../packages/hwpjs/src/runtime.ts"
      ],
      "@ohah/hwpjs/vanilla": [
        "../../packages/hwpjs/src/vanilla.ts"
      ],
      "@ohah/hwpjs/react": [
        "../../packages/hwpjs/src/react.ts"
      ],
      "@ohah/hwpjs/svelte": [
        "../../packages/hwpjs/src/svelte.ts"
      ],
      "@ohah/hwpjs/react-native": [
        "../../packages/hwpjs/src/react-native.ts"
      ]
    }
  },
  "include": [
    "examples/**/*.ts",
    "examples/**/*.tsx",
    "types/**/*.d.ts",
    "rspress.config.ts",
    "components/**/*.tsx",
    "theme/**/*.tsx"
  ]
}
