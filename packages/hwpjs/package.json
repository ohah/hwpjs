      "default": "./dist/react-native.js"
    },
    "./worker": "./dist/worker.js",
    "./wasm": "./dist/hwpjs.wasm",
    "./package.json": "./package.json",
    "./react-native/canvas": {
      "types": "./dist/types/react-native/src/canvas.d.ts",
      "react-native": "./dist/react-native-canvas.js",
      "import": "./dist/react-native-canvas.js"
    },
    "./react-native/canvas/podspec": "./dist/native/react-native/HwpjsNativeCanvas.podspec"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "svelte": "^5.57.2",
    "react-native": ">=0.83.1 <0.84"
  },
  "peerDependenciesMeta": {
